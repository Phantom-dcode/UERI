# Email delivery for Cloud Functions (SMTP is the only implemented provider).
# Copy to functions/.env for local deployment/emulator use, or configure these
# values as backend secrets. Never put SMTP credentials in the Android app's .env.
# SMTP_FROM must be an address/domain authorized by your SMTP provider.
# SMTP acceptance does not confirm inbox delivery.
SMTP_HOST=smtp.resend.com
SMTP_PORT=587
SMTP_USER=resend
SMTP_PASS=re_your_api_key_here
SMTP_FROM='"UERI Security" <no-reply@ueri-emergency.org>'
