rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    match /evidence/{emergencyId}/{evidenceFile} {
      // Allow authenticated reads
      allow read: if request.auth != null;

      // Allow write if authenticated and uploading valid media type with max size 100MB
      allow write: if request.auth != null
        && request.resource.size < 100 * 1024 * 1024
        && (
          request.resource.contentType.matches('image/.*') ||
          request.resource.contentType.matches('audio/.*') ||
          request.resource.contentType.matches('video/.*') ||
          request.resource.contentType.matches('application/octet-stream')
        );

      allow delete: if request.auth != null && request.auth.token.role == 'CONTROL_OPERATOR';
    }
  }
}
