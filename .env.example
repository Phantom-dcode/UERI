# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# GEMINI_API_KEY=MY_GEMINI_API_KEY

# MAPS_API_KEY: Google Maps SDK API key
MAPS_API_KEY=AIzaSyDummyKeyForMapsPlatformInit

# REAL EMAIL DELIVERY PROVIDER (SMTP / Resend / SendGrid / SES / Mailgun)
# Configure these in backend environment secrets to dispatch real emails:
# SMTP_HOST=smtp.resend.com
# SMTP_PORT=587
# SMTP_USER=resend
# SMTP_PASS=re_your_api_key_here
# SMTP_FROM="UERI Security" <no-reply@ueri-emergency.org>
